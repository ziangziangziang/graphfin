# Time-series reads (PROJECT.md S2).
#
# The YAGO fixture gives every Person three daily points from 2024-01-01:
# close 10/11/12 and volume 100/200/300. Vanessa Redgrave has a null close on
# the middle day, so the null path is covered here too.

MATCH (p:Person {name:'Rachel Kempson'}) RETURN p.prices AS summary;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.count(p, 'prices') AS n;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.count(p, 'prices', datetime('2024-01-02 00:00:00'), datetime('2024-01-02 00:00:00')) AS n;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.range(p, 'prices', datetime('2024-01-01 00:00:00'), datetime('2024-01-03 00:00:00')) AS points;

# The bounds are inclusive, so a single-instant window returns that one point.
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.range(p, 'prices', datetime('2024-01-02 00:00:00'), datetime('2024-01-02 00:00:00')) AS points;

# A window with no points is an empty list, not an error.
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.range(p, 'prices', datetime('2030-01-01 00:00:00'), datetime('2030-01-02 00:00:00')) AS points;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.at(p, 'prices', datetime('2024-01-02 00:00:00')) AS point;

# No point at that instant: null rather than an empty map, so it is distinguishable.
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.at(p, 'prices', datetime('2030-01-01 00:00:00')) AS point;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.latest(p, 'prices') AS point, series.earliest(p, 'prices') AS first_point;

# A null measure stays null in the map rather than being dropped.
MATCH (p:Person {name:'Vanessa Redgrave'}) RETURN series.at(p, 'prices', datetime('2024-01-02 00:00:00')) AS point;

MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.mean(p, 'prices', 'close') AS mean, series.min(p, 'prices', 'close') AS min, series.max(p, 'prices', 'close') AS max, series.sum(p, 'prices', 'close') AS sum;

# An integer measure aggregates to integers, except the mean which is fractional.
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.mean(p, 'prices', 'volume') AS mean, series.min(p, 'prices', 'volume') AS min, series.max(p, 'prices', 'volume') AS max, series.sum(p, 'prices', 'volume') AS sum;

# A null measure does not take part in an aggregate.
MATCH (p:Person {name:'Vanessa Redgrave'}) RETURN series.mean(p, 'prices', 'close') AS mean, series.count(p, 'prices') AS n;

# The dot cannot be expressed by the GQL lexer, so the underscore alias is
# registered as well; on this parser path both names must behave identically.
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series_range(p, 'prices', datetime('2024-01-01 00:00:00'), datetime('2024-01-03 00:00:00')) AS points;

-- error
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.count(p, 'name') AS n;

-- error
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.count(p, 'nope') AS n;

-- error
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.mean(p, 'prices', 'nope') AS m;

-- error
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.range(p, 'prices') AS points;

# Members of a returned map stay accessible through WITH, including the
# measures list (non-scalars used to be rejected here).
MATCH (p:Person {name:'Rachel Kempson'}) WITH p.prices AS s RETURN s.count AS n, s.first AS first, s.last AS last, s.measures AS names;

MATCH (p:Person {name:'Rachel Kempson'}) WITH series.at(p, 'prices', datetime('2024-01-02 00:00:00')) AS point RETURN point.close AS close, point.volume AS volume;

# Roy Redgrave's volumes cannot be summed in INT64: min/max/mean stay
# well-defined, the sum refuses instead of wrapping.
MATCH (p:Person {name:'Roy Redgrave'}) RETURN series.min(p, 'prices', 'volume') AS min, series.max(p, 'prices', 'volume') AS max, series.mean(p, 'prices', 'volume') AS mean;

-- error
MATCH (p:Person {name:'Roy Redgrave'}) RETURN series.sum(p, 'prices', 'volume') AS sum;

-- error
MATCH (p:Person {name:'Rachel Kempson'}) RETURN series.count(p, 'name') AS n;

# A series has no bytes in the record, so the ordinary property API refuses it
# rather than storing something the store will never read back.
-- error
MATCH (p:Person {name:'Rachel Kempson'}) SET p.prices = 'x';
